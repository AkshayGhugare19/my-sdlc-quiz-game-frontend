# Learning Games (racing) frontend — environment
# The game talks to the GamifiedLearning API directly (no learning-games backend).
VITE_GAMRU_API_URL=http://localhost:4000
VITE_APP_NAME=SDLC Quest


# --- Embedded Unity racing build ---
# false = play the original in-repo three.js circuit instead (backup path)
VITE_USE_UNITY_RACE=true
# Optional: point at a local/dev Unity build instead of the URL the API returns
# VITE_UNITY_RACE_URL=http://localhost:8080
